enum DepositStatus {
  pending
  detected
  confirmed
  swept
  expired
}

enum WithdrawalStatus {
  pending
  completed
  failed
}

enum BalanceEntryType {
  deposit
  withdrawal
}

//

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

model User {
  id           String           @id @default(cuid())
  name         String           @unique
  password     String
  balanceUnits BigInt           @default(0)
  ledger       balance_entry[]
  deposits     crypto_deposit[]
  withdrawals  withdrawal[]

  @@map("users")
}

model balance_entry {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  type         BalanceEntryType
  amountUnits  BigInt
  createdAt    DateTime         @default(now())
  operationRef String           @unique

  @@index([userId, createdAt])
}

model crypto_deposit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address     String @unique
  index       Int    @unique
  amountUnits BigInt

  txHash      String?
  blockNumber BigInt?

  status         DepositStatus @default(pending)
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  confirmedAt    DateTime?
  sweepStartedAt DateTime?
  sweptAt        DateTime?

  transfers deposit_transfer[]

  @@index([userId])
  @@index([status])
}

model deposit_transfer {
  id String @id @default(cuid())

  depositId String
  deposit   crypto_deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  txHash      String
  logIndex    Int
  amountUnits BigInt
  blockNumber BigInt
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([depositId])
}

model withdrawal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address     String
  amountUnits BigInt
  feeUnits    BigInt
  txHash      String?

  status    WithdrawalStatus @default(pending)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([status])
}

model deposit_counter {
  id        String @id
  value     Int    @default(0)
  lastBlock BigInt @default(0)
}
